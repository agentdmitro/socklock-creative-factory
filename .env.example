# Copy to .env.local (git-ignored). Everything is optional: without a key the app runs in Mock mode.
# These are read on the server only; never prefix them with NEXT_PUBLIC_.

# Default idea provider: "mock" (offline, deterministic) or "gemini". Gemini is only used when a key is set.
AI_PROVIDER=mock

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cost-efficient text model. Verified as stable on the official models page on 2026-11-08;
# gemini-3.5-flash-lite and gemini-2.5-flash-lite are alternatives. Check with: npm run ai:check
GEMINI_MODEL=gemini-3.1-flash-lite

# Safety limits for the single batch request (defaults shown)
# AI_TIMEOUT_MS=20000
# AI_MAX_OUTPUT_TOKENS=2048

# USD per 1M tokens used for the *estimated* cost (defaults match gemini-3.1-flash-lite list prices).
# Update these if you change model. The real charge appears only in your Google billing console.
# AI_PRICE_INPUT_PER_M=0.25
# AI_PRICE_OUTPUT_PER_M=1.5

# Where the local analytics log lives (default: ./data/events.jsonl). Counts, durations and costs only.
# CVF_DATA_DIR=./data
